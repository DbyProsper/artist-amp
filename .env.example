# GIPHY developer API key for GIF and sticker search in chats and comments
VITE_GIPHY_API_KEY="your_giphy_api_key"

# Optional but recommended for reliable voice/video calls on restrictive mobile networks
VITE_TURN_URL="turn:your-turn-server.example.com:3478"
VITE_TURN_USERNAME="your_turn_username"
VITE_TURN_CREDENTIAL="your_turn_credential"
