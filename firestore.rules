rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'mthabisisebata113@gmail.com';
    }
    function isAdmin() {
      return request.auth != null && (isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )) ||
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_admin == true)
      );
    }
    // Users collection - read own, write own but NOT plan/quota fields
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSuperAdmin() || (request.auth != null
        && request.auth.uid == uid
        && !('plan' in request.resource.data)
        && !('quota' in request.resource.data)
        && !('quotaDaily' in request.resource.data)
        && !('payfastToken' in request.resource.data)
        && !('payfastEmail' in request.resource.data)
        && !('stripeCustomerId' in request.resource.data)
        && !('stripeSubscriptionId' in request.resource.data)
        && !('is_admin' in request.resource.data)
        && !('role' in request.resource.data)
        && !('roles' in request.resource.data));
    }

    // One-off payment enhance tokens — readable by owner, managed by backend only
    match /purchases/{uid}/tokens/{tokenId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // PayFast event log — never accessible by clients
    match /payfastEvents/{eventId} {
      allow read, write: if false;
    }

    // Stripe events log (written by Cloud Function only, never by client)
    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    // Users can read all profiles but only write their own
    match /profiles/{userId} {
      allow read: if true;
      allow create: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if request.auth != null && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['is_admin', 'role', 'roles'])) ||
        (isAdmin() && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['is_admin', 'role', 'roles']) || isSuperAdmin()))
      );
      allow delete: if isSuperAdmin();
    }

    match /studio_projects/{projectId} {
      allow create: if request.auth != null && request.resource.data.owner_id == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.owner_id == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner_id == request.auth.uid && request.resource.data.owner_id == request.auth.uid;
    }

    match /studio_states/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy DAW snapshots remain owner-only while current projects use
    // studio_projects. This allows safe migration without exposing sessions.
    match /studio_sessions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /albums/{albumId} {
      allow read: if true;
      allow create: if request.auth != null && (request.resource.data.profile_id == request.auth.uid || (isAdmin() && request.resource.data.profile_id == 'musicinsta-official'));
      allow update: if request.auth != null && (
        resource.data.profile_id == request.auth.uid || isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments', 'shares', 'plays'])
      );
      allow delete: if request.auth != null && (resource.data.profile_id == request.auth.uid || isAdmin());
    }

    match /messages/{messageId} {
      allow create: if request.auth != null && (request.resource.data.sender_id == request.auth.uid || (isAdmin() && request.resource.data.sender_id == 'musicinsta-official'));
      allow read, update: if request.auth != null && (resource.data.sender_id == request.auth.uid || resource.data.recipient_id == request.auth.uid || (isAdmin() && (resource.data.sender_id == 'musicinsta-official' || resource.data.recipient_id == 'musicinsta-official')));
      allow delete: if request.auth != null && (resource.data.sender_id == request.auth.uid || (isAdmin() && resource.data.sender_id == 'musicinsta-official'));
    }

    match /conversations/{conversationId} {
      allow create: if request.auth != null && (request.auth.uid in request.resource.data.participant_ids || (isAdmin() && 'musicinsta-official' in request.resource.data.participant_ids));
      allow read: if request.auth != null && (request.auth.uid in resource.data.participant_ids || (isAdmin() && 'musicinsta-official' in resource.data.participant_ids));
      allow update: if request.auth != null && ((request.auth.uid in resource.data.participant_ids && request.auth.uid in request.resource.data.participant_ids) || (isAdmin() && 'musicinsta-official' in resource.data.participant_ids));
      allow delete: if request.auth != null && request.auth.uid in resource.data.participant_ids;
    }

    // Songs - users can read all songs, but only authenticated users can create
    match /songs/{songId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.user_id;
    }

    // Allow authenticated users to read and write their own data in other collections
    match /playlists/{playlistId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.creator_id || (isAdmin() && request.resource.data.creator_id == 'musicinsta-official'));
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.creator_id || (isAdmin() && resource.data.creator_id == 'musicinsta-official'));
    }

    match /tracks/{trackId} {
      allow read: if true;
      allow create: if request.auth != null && (request.resource.data.profile_id == request.auth.uid || (isAdmin() && request.resource.data.profile_id == 'musicinsta-official'));
      allow update: if (request.auth != null && (
        resource.data.profile_id == request.auth.uid || isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plays', 'likes', 'comments', 'shares'])
      )) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plays'])
        && request.resource.data.plays == resource.data.plays + 1);
      allow delete: if request.auth != null && (resource.data.profile_id == request.auth.uid || isAdmin());
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && (request.resource.data.profile_id == request.auth.uid || isAdmin());
      allow update: if (request.auth != null && (
        resource.data.profile_id == request.auth.uid || isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments', 'shares', 'plays'])
      )) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plays'])
        && request.resource.data.plays == resource.data.plays + 1);
      allow delete: if request.auth != null && (resource.data.profile_id == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null && (request.resource.data.author_id == request.auth.uid || (isAdmin() && request.resource.data.author_id == 'musicinsta-official'));
        allow update, delete: if request.auth != null && (resource.data.author_id == request.auth.uid || isAdmin());
      }
    }

    match /post_likes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        request.resource.data.user_id == request.auth.uid ||
        (isAdmin() && request.resource.data.user_id == 'musicinsta-official')
      );
      allow delete: if request.auth != null && (
        resource.data.user_id == request.auth.uid ||
        (isAdmin() && resource.data.user_id == 'musicinsta-official')
      );
    }

    match /saved_posts/{saveId} {
      allow read, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    match /playlist_tracks/{membershipId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (get(/databases/$(database)/documents/playlists/$(request.resource.data.playlist_id)).data.creator_id == request.auth.uid || (isAdmin() && get(/databases/$(database)/documents/playlists/$(request.resource.data.playlist_id)).data.creator_id == 'musicinsta-official'));
      allow delete: if request.auth != null && (get(/databases/$(database)/documents/playlists/$(resource.data.playlist_id)).data.creator_id == request.auth.uid || (isAdmin() && get(/databases/$(database)/documents/playlists/$(resource.data.playlist_id)).data.creator_id == 'musicinsta-official'));
    }

    match /follows/{followId} {
      allow read: if true;
      allow create: if request.auth != null && (
        request.resource.data.follower_id == request.auth.uid ||
        (isAdmin() && request.resource.data.follower_id == 'musicinsta-official')
      );
      allow delete: if request.auth != null && (
        resource.data.follower_id == request.auth.uid ||
        (isAdmin() && resource.data.follower_id == 'musicinsta-official')
      );
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if request.auth != null && resource.data.profile_id == request.auth.uid;
      allow create: if request.auth != null && (request.resource.data.from_profile_id == request.auth.uid || isAdmin());
    }

    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reporter_id == request.auth.uid;
      allow read, update: if isAdmin();
    }

    match /verification_requests/{requestId} {
      allow create: if request.auth != null && request.resource.data.profile_id == request.auth.uid;
      allow read: if request.auth != null && (resource.data.profile_id == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /genres/{genreId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Private recommendation signals. A listener may only access their own
    // history; these documents are never a public popularity signal.
    match /listening_history/{historyId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.user_id;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.user_id
        && request.auth.uid == request.resource.data.user_id;
    }

    match /track_likes/{likeId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.user_id;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.user_id
        && request.auth.uid == request.resource.data.user_id;
    }

    match /story_likes/{likeId} {
      allow read, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    match /user_preferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Social links
    match /social_links/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Unknown collections are readable to signed-in users but never writable
    // from an unreviewed client path.
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
